{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".npmrc"],
  "globalEnv": [
    "VERCEL_ENV",
    "NEXT_PUBLIC_*",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_TELEFONO",
    "NEXT_PUBLIC_WHATSAPP",
    "NEXT_PUBLIC_DIRECCION",
    "NEXT_PUBLIC_GA_ID",
    "NEXT_PUBLIC_ADS_ID",
    "NEXT_PUBLIC_ADS_ETIQUETA_LLAMADA",
    "NEXT_PUBLIC_META_PIXEL_ID",
    "EMAIL_DESTINO",
    "RESEND_API_KEY",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_CHAT_ID",
    "META_CAPI_ACCESS_TOKEN",
    "META_CAPI_TEST_EVENT_CODE"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "^transit", "^content:validate", "content:validate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "^transit"],
      "outputs": []
    },
    "content:validate": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/public/**"],
      "outputs": []
    }
  }
}
