# Servidor — solo se leen en Server Actions/route handlers, vía @site/config/server.
# Nunca llegan al bundle cliente. Ver el README de la raíz para la tabla completa.
RESEND_API_KEY=
# Destino real del email del formulario de presupuesto. Sin ella, cae a
# comercial@pavimentos-albufera.com (app/presupuesto/actions.ts) — no al email
# público del NAP.
EMAIL_DESTINO=comercial@pavimentos-albufera.com
META_CAPI_ACCESS_TOKEN=
# Código de evento de prueba de Meta CAPI (Test Events en el panel de Meta). Opcional.
META_CAPI_TEST_EVENT_CODE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Públicas — NEXT_PUBLIC_*, se leen también en el navegador (Next las inyecta en
# build solo como literal process.env.NEXT_PUBLIC_X).
# ID de GA4/Google tag (G-…). Sin ella (y sin NEXT_PUBLIC_ADS_ID), no se carga gtag.js.
NEXT_PUBLIC_GA_ID=
# ID de conversión de Google Ads (AW-…). Sin ella (y sin NEXT_PUBLIC_GA_ID), tampoco se carga gtag.js.
NEXT_PUBLIC_ADS_ID=
# Etiqueta de conversión de Google Ads para la llamada, sin el prefijo AW-.
NEXT_PUBLIC_ADS_ETIQUETA_LLAMADA=
# Sin ella, todo tel: del sitio cae al marcador <DatoPendiente> (build entero, no por página).
NEXT_PUBLIC_TELEFONO=
# Sin ella, ningún botón de WhatsApp se pinta.
NEXT_PUBLIC_WHATSAPP=
# Sin ella, cae al marcador <DatoPendiente> de dirección.
NEXT_PUBLIC_DIRECCION=
# Origen absoluto para canonical, sitemap, JSON-LD, og:url. Sin ella cae al valor
# fijo de @site/config/site.ts.
NEXT_PUBLIC_SITE_URL=https://pavimentos-albufera.com
# ID numérico del Meta Pixel. Sin ella, no se carga el Pixel ni su PageView.
NEXT_PUBLIC_META_PIXEL_ID=
